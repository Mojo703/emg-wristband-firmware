# 4 MB flash on the ESP32-S3-Zero.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom partition table (see partitions.csv). Path via PROJECT_DIR env var
# because esp-idf-sys runs cmake from a generated dir (cmake expands $ENV{...}).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="$ENV{PROJECT_DIR}/partitions.csv"

# Run at full 240 MHz so the benchmark reflects peak performance. The default is
# 160 MHz; without this the numbers would understate the chip.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_FREERTOS_HZ=1000
