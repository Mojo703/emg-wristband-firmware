/target
# Runtime state (provenance.cbor) lives in /config alongside collection.json,
# which is shipped content — so /config's *contents* are ignored rather than the
# directory, which is what lets the negation work.
/config/*
!/config/collection.json
!/config/collection-modifier.json
# The track library: audio, converted schedules, and the Beat Saber maps they
# came from. Personal music, re-importable from the dashboard.
/tracks
# Recorded collection sessions land here at runtime.
/sessions
/web/node_modules
/web/dist
