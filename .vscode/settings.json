{
  // Opening the repo root loads every subproject, so this mirrors
  // opal-firmware/.vscode/settings.json. esp-idf-sys's build script runs
  // bindgen, which needs LIBCLANG_PATH; ~/.espup/esp-clang is the stable
  // symlink espup maintains.
  "rust-analyzer.cargo.extraEnv": {
    "LIBCLANG_PATH": "${userHome}/.espup/esp-clang"
  },
  // The extension's bundled server passes `cargo metadata --lockfile-path`,
  // which neither the esp nor the host cargo accepts, so every project falls
  // back to `--no-deps` and loses its dependency graph.
  "rust-analyzer.server.path": "${userHome}/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/rust-analyzer"
}
