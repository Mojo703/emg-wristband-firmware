# 4 MB flash on the ESP32-S3-Zero.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom partition table (see partitions.csv): one large app slot + nvs (config).
# Path via PROJECT_DIR env var because esp-idf-sys runs cmake from a generated dir.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="$ENV{PROJECT_DIR}/partitions.csv"

# Full clock for real-time inference headroom.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Bluetooth: the NimBLE host only, brought up before the ADC and feedback
# drivers so its largest allocation sees the fresh boot heap. Bonding keys
# persist in NVS so the phone stays paired across reboots.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Room for a second central, so the band keeps advertising while a phone holds
# it: iOS reclaims a bonded band as HID the moment it advertises, and the phone
# app can only find a band that is still on the air. These match the link
# bench (ble-media), where the behaviour was verified on an iPhone.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# One subscription record per notifying characteristic per bonded peer. NimBLE
# answers an overflow by unpairing the oldest peer.
CONFIG_BT_NIMBLE_MAX_CCCDS=24
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
# At info level NimBLE prints two lines per notification from inside the
# notify call; measured on the link bench, that held every notification ~10 ms.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# The core plan lives in src/cores.rs; this pins the task that sdkconfig owns.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# The Rust main task runs inference. `App::new` returns a boxed owner from a
# non-inlined constructor so its startup frame cannot remain beneath the permanent
# run loop: retaining both frames overflowed this stack into the adjacent esp_timer
# TCB. Every KB here is contiguous internal RAM the heap needs back.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_FREERTOS_HZ=1000

# Console on the USB port: logs go to the USB-Serial-JTAG monitor. This
# board's UART0 pins go nowhere.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# A hung task must reboot the chip, not print a warning. The main loop
# subscribes itself to the task watchdog and feeds it every pass (src/main.rs);
# the boot log's reset reason then names the hang.
CONFIG_ESP_TASK_WDT_PANIC=y
