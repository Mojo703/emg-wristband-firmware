# 4 MB flash on the ESP32-S3-Zero.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom partition table (see partitions.csv): one large app slot + nvs (config).
# Path via PROJECT_DIR env var because esp-idf-sys runs cmake from a generated dir.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="$ENV{PROJECT_DIR}/partitions.csv"

# Full clock for real-time inference headroom.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# The core plan lives in src/cores.rs; these pin the tasks that sdkconfig owns.
# Main and wifi are the esp-idf defaults, stated so the plan does not rest on
# them staying default; lwIP floats by default and is pinned to core 0 here to
# keep networking off the acquisition core (measured: no cost on the serial
# bench, and it removes the one task that could wander onto core 1 under load).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# The Rust main task runs inference + framing. Inference works through the model's
# own heap-resident scratch buffers and framing through the links' shared encode
# buffer, so the stack holds no window-sized locals; 16 KB is still generous, and
# every KB here is contiguous internal RAM the heap needs back (TCP's link threads
# alone want two 8 KB stacks at dial time).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_FREERTOS_HZ=1000

# TCP throughput to the dashboard. The lwIP default send buffer (5760 B, 4 segments)
# caps the stream well below one EMG window per window period: each ~8.5 KB frame
# needed several buffer-drain round trips, the writer fell behind, and the transport
# queue dropped half the windows. 16 KB holds a whole window plus slack in flight.
# Heap is tight (the model + a 16 KB window blob live alongside): 32 KB send buffer
# and 64 dynamic TX buffers ran the device out of memory, so don't raise these
# without watching free heap.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=8960
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

# A wider TX block-ack window so the radio can aggregate the burst instead of
# trickling it out; buffer counts stay at the defaults for heap headroom.
CONFIG_ESP_WIFI_TX_BA_WIN=16

# lwIP hot path in IRAM (~13 KB of IRAM for a solid throughput bump).
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# No text console: the USB-Serial-JTAG CDC channel carries the framed CBOR dashboard
# link (src/transport.rs), and logs ride the protocol as Frame::Log (src/logger.rs).
# Secondary console off too, or ESP-IDF would put one right back on the CDC.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# A hung task must reboot the chip, not print an (invisible, console-less) warning.
# The main loop subscribes itself to the task watchdog and feeds it every window
# (src/main.rs); the boot log's reset reason then names the hang.
CONFIG_ESP_TASK_WDT_PANIC=y
