# Overrides for on-device `cargo test` runs, layered after sdkconfig.defaults:
#
#   ESP_IDF_SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.test" cargo test
#
# libtest runs each test on a pthread, and the ESP-IDF default 3 KB stack is too
# thin for the conditioning and model tests: the overflow presents as a wild
# pointer load, not as a stack-overflow message.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
