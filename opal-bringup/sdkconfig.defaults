# 4 MB flash on the ESP32-S3-Zero.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# A plain text console, which is the whole difference from opal-firmware: that binary
# gives the USB-Serial-JTAG channel to framed CBOR and routes logs through the
# dashboard link, so nothing is readable until a link comes up. Here `println!` and
# `log` go straight out the same cable and `espflash monitor` shows them.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The DRDY poll loop spins rather than blocking, so it starves the idle task by
# design. Nothing else runs on this chip -- no wifi, no second thread -- so the
# watchdog has nothing useful to say and would only reboot mid-measurement.
CONFIG_ESP_TASK_WDT_INIT=n
