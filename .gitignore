# Build artifacts and toolchain checkouts. Each subproject also has its own
# .gitignore; this catches the same junk at the repo root (e.g. a stray
# firmware build directory) so it never gets committed by accident.
/target
target/
/firmware
.embuild/
node_modules/
dist/
/tmp
documentation/
# JetBrains project files (RustRover).
.idea/
# Python virtual environments (e.g. pose-service/.venv).
.venv/

# Python bytecode from the emg-tds analysis scripts.
__pycache__/
